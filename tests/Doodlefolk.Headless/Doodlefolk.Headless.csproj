<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Compile the real production algorithms, not test copies or Windows/renderer stubs. -->
  <ItemGroup>
    <Compile Include="../../Ballistics.cs" Link="Production/Ballistics.cs" />
    <Compile Include="../../Coverage.cs" Link="Production/Coverage.cs" />
    <Compile Include="../../PropKind.cs" Link="Production/PropKind.cs" />
    <Compile Include="../../Util.cs" Link="Production/Util.cs" />
  </ItemGroup>
</Project>
