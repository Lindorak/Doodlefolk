<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WebView2 brings a newer WindowsBase than WinForms references; harmless, and it buries real warnings. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;publish/**;dist/**</DefaultItemExcludes>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Doodlefolk</RootNamespace>
    <AssemblyName>Doodlefolk</AssemblyName>
    <Version>1.1.0</Version>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Precompiled code starts faster; the small managed heap does not need a background GC thread. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <Product>Doodlefolk</Product>
    <Description>Stick figures that live, play and fight on your Windows desktop.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="System.Speech" Version="9.0.20" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Studio\web\**\*" Exclude="Studio\web\mock-*" LogicalName="studio/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Doodlefolk.Tests" />
  </ItemGroup>

  <!-- Steam: Steamworks.NET (MIT) always; Valve's steam_api64.dll only when it's there (tools/get-steam-dll.ps1), and
       left out of the plain GitHub build: without it Doodlefolk simply runs without Steam. -->
  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>lib\steam\Steamworks.NET.dll</HintPath>
    </Reference>
    <None Include="lib\steam\steam_api64.dll" Condition="Exists('lib\steam\steam_api64.dll') And '$(NoSteam)' != 'true'">
      <Link>steam_api64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
